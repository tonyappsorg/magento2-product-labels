<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="tonyapps_product_label_rule" resource="default" engine="innodb" comment="Tonyapps Product Label Rules">
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="true" comment="Rule ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Admin Rule Name"/>
        <column xsi:type="varchar" name="label" length="80" nullable="false" comment="Badge Text"/>
        <column xsi:type="varchar" name="background_color" length="7" nullable="false" default="#333333" comment="Badge Background Color"/>
        <column xsi:type="varchar" name="text_color" length="7" nullable="false" default="#FFFFFF" comment="Badge Text Color"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="text" name="store_ids" nullable="true" comment="Comma-separated Store View IDs; empty means all"/>
        <column xsi:type="mediumtext" name="conditions_serialized" nullable="true" comment="Serialized Product Conditions"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="rule_id"/></constraint>
        <index referenceId="TONYAPPS_PRODUCT_LABEL_ACTIVE_SORT" indexType="btree"><column name="is_active"/><column name="sort_order"/></index>
    </table>
</schema>
